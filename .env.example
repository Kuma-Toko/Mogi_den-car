# このファイルをコピーして .env を作成する（.env は gitignore 済み）。
#   cp .env.example .env

# ── データベース ────────────────────────────────────────────────────────────
# ローカル開発: Prisma のマイグレーションとシードが使うローカルSQLiteファイル。
#   DATABASE_URL="file:./prisma/dev.db"
# 本番(Turso): libsql:// スキームで authToken をクエリに含める。
#   DATABASE_URL="libsql://<db-name>-<org>.turso.io?authToken=<token>"
# 本番(NODE_ENV=production)では未設定だと起動時に例外を投げる（空DBへ静かに接続するのを防ぐため）。
# prisma/*-turso.ts 系のスクリプトは file: 始まりの値を拒否するので、実行時はリモートを指すこと。
DATABASE_URL="file:./prisma/dev.db"

# ── セッション ──────────────────────────────────────────────────────────────
# ログインセッションのCookie名。未設定でも動作する（src/lib/auth.ts の既定値を使う）。
SESSION_COOKIE_NAME="mogi_dencal_session"

# ── Gemini（AI模擬患者・AI治療評価） ────────────────────────────────────────
# 未設定の場合、問診チャットとAI治療評価の初回呼び出し時に例外になる。
# サーバー専用（src/lib/gemini.ts は "server-only"）。NEXT_PUBLIC_ を付けないこと。
GEMINI_API_KEY=""

# 使用モデル。未設定なら gemini-3.5-flash-lite。429 の場合は順にフォールバックする。
# GEMINI_MODEL="gemini-3.5-flash-lite"
