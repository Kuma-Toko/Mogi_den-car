generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

// 症例区分
enum CaseType {
  SIMULATION // シミュレーション用
  ROUTINE_COMMON // 実習常時利用（共通プール）
  ROUTINE_PATIENT // 実習常時利用（実患者ベース）
}

// 時間進行方式
enum TimeProgressMode {
  REALTIME // 実時間進行（実習常時利用ツール）
  MANUAL // 学習者が手動で進行（シミュレーション用ツール）
}

// 複数学生の共有設定
enum SharingMode {
  SOLO // 単一学生専用
  TEAM // チームで共有
}

// 検査結果の取得タイミング
enum ResultTiming {
  IMMEDIATE // 即時型
  DELAYED // 遅延型
}

// 病態テンプレートに紐づく「危機シナリオ」発生時、未救命のまま猶予時間を過ぎたときの扱い
enum CrisisMode {
  OFF // 危機シナリオを発生させない（従来通り病態モデルのみ）
  REVERSIBLE // 猶予時間を過ぎても死亡させず、CRITICALのまま留まる（いつでも救命オーダーで脱出可）
  LETHAL // 猶予時間内に救命オーダーがなければDECEASEDに遷移
}

// 症例の危機状態
enum CrisisState {
  STABLE // 通常の病態モデルに従う
  CRITICAL // 危機シナリオ発生中（救命オーダー待ち）
  DECEASED // 死亡（症例凍結）
}

enum CaseStatus {
  DRAFT // 下書き
  ACTIVE // 公開・進行中
  SIMULATING // 演習中（シミュレーション実施中）
  CLOSED // 終了
}

// 問診・身体診察AIチャットの発言者区分
enum EncounterRole {
  STUDENT // 学生からの質問・診察指示
  PATIENT // AI（模擬患者役）の応答・所見
}

// カルテ記載の様式区分
enum KarteEntryType {
  SOAP // SOAP形式
  NARRATIVE // フリー記載（経過記録・退院時サマリ等の自由記述）
  REFERRAL // 紹介状（診療情報提供書）
  AMBULANCE // 救急搬送記録
}

enum OrderType {
  LAB // 検査
  IMAGING // 画像検査
  MEDICATION // 処方
  INJECTION // 注射・点滴
  GENERAL // 一般指示
  PROCEDURE // 処置・手術
}

enum OrderStatus {
  ORDERED // オーダー済
  RESULT_PENDING // 結果待ち
  RESULT_PRELIMINARY // 速報結果あり（培養のグラム染色等、確定結果はまだ）
  RESULT_AVAILABLE // 結果あり
  ADMINISTERED // 実施済
  ACTIVE // 有効（一般指示など）
  DISCONTINUED // 中止
}

// AI治療評価（都度、治療内容を生成AIに評価させ重症度カーブへ反映する仕組み）の進行状況
enum TreatmentEvaluationStatus {
  PENDING // オーダー提出直後に作成。バックグラウンドでのAI呼び出し待ち
  COMPLETED // AI評価が完了（成功）
  FAILED // AI呼び出し・応答パースの失敗、または評価開始前に危機状態へ遷移したため中止
}

model User {
  id           String   @id @default(cuid())
  loginId      String   @unique
  passwordHash String
  name         String
  role         Role
  affiliation  String? // 例: 消化器内科ローテーション / 消化器内科 指導医
  grade        String? // 例: 医学部5年
  createdAt    DateTime @default(now())

  sessions          Session[]
  createdCases      Case[]             @relation("CaseCreator")
  assignments       CaseAssignment[]
  karteEntries      KarteEntry[]
  encounterMessages EncounterMessage[]
  orders            Order[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  diseaseTemplates  DiseaseTemplate[]  @relation("TemplateCreator")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Case {
  id               String           @id @default(cuid())
  caseCode         String           @unique // P-1042, SIM-07 等の表示ID
  title            String // 症例名
  caseType         CaseType
  status           CaseStatus       @default(DRAFT)
  timeProgressMode TimeProgressMode
  sharingMode      SharingMode      @default(SOLO)
  resultTiming     ResultTiming     @default(IMMEDIATE)
  simNowAt         DateTime? // MANUAL（シミュレーション）症例の仮想時計。学習者が手動で進行させる

  patientName   String
  patientAge    Int
  patientGender String
  ward          String?
  bed           String?

  visibilityScope String? // 公開範囲の説明

  crisisMode           CrisisMode  @default(LETHAL) // 危機シナリオ未救命時の扱い。主病態にcrisisRescueが未定義なら実質無視される
  crisisState          CrisisState @default(STABLE)
  crisisStartedAt      DateTime? // 危機シナリオ発生時刻（救命オーダー判定の起点）

  historyScript String? // 問診AI用の台本。現病歴・既往歴・アレルギー・生活歴等、学生の質問に対する根拠情報
  examScript    String? // 身体診察AI用の台本。視診・触診・打診・聴診など系統別の所見

  createdByUserId String
  createdBy       User      @relation("CaseCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?

  diseaseLinks         CaseDiseaseLink[]
  assignments          CaseAssignment[]
  problems             Problem[]
  karteEntries         KarteEntry[]
  encounterMessages    EncounterMessage[]
  orders               Order[]
  vitals               Vital[]
  notifications        Notification[]
  treatmentEvaluations TreatmentEvaluation[]
  crisisTriggerProgress CaseCrisisTriggerProgress[]
}

model CaseAssignment {
  id           String    @id @default(cuid())
  caseId       String
  case         Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  studentId    String
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedAt   DateTime  @default(now())
  dischargedAt DateTime? // 退院日時。null=担当中、値あり=退院済み（担当患者一覧からは除外し、退院済み患者として保持）

  @@unique([caseId, studentId])
}

// 症例に複数アタッチできる病態モデル。各疾患は完全に独立した重症度カーブ・治療トリガー・改善速度を持つ
// （疾患間の相互作用は今回スコープ外）。isPrimaryの1件だけが危機シナリオ・AI治療評価の対象になる。
model CaseDiseaseLink {
  id                 String          @id @default(cuid())
  caseId             String
  case               Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  templateId         String
  template           DiseaseTemplate @relation(fields: [templateId], references: [id])
  isPrimary          Boolean         @default(false) // 危機シナリオ・AI治療評価の対象として使う1件（症例につき1つ）
  physiologyParams   String // JSON文字列(PhysiologyParams): 初期値・変化パラメータ（改善速度・重症度 等）
  // 重症度カーブの起点。通常は症例作成時刻相当だが、危機シナリオからの救命成功時やAI治療評価時に
  // その時刻へリセットされ、以降はそこを新たな起点として重症度が再計算される
  severityBaselineAt DateTime @default(now())
  // AI治療評価（isPrimaryの疾患のみ対象）が一度でも発火すると設定される、時間あたりの重症度変化量
  // （正=悪化、負=改善）。null＝AI評価が未発火で、従来のtreatmentStartAt起点の指数減衰カーブを使う
  // （physiology-engine.tsのcomputeCaseSeverityAtTime参照）
  aiSeverityRatePerHour Float?
  sortOrder          Int      @default(0)
  // 感染症エンジン: この疾患リンクの「真の原因菌」。感染症系テンプレート(isInfectious)でのみ教員が設定する。
  // 未設定(null)の場合、培養オーダーは原因菌モデルを使わず既存の固定サンプル文にフォールバックする。
  pathogenId String?
  pathogen   PathogenMaster? @relation(fields: [pathogenId], references: [id], onDelete: SetNull)

  @@unique([caseId, templateId])
}

model Problem {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  label     String
  isPrimary Boolean  @default(false)
  status    String   @default("active")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// カルテ記載1件分。様式（entryType）によって使用するフィールドが異なる：
// - SOAP: subjective/objective/assessment/plan
// - NARRATIVE: narrative（自由記述本文）
// - REFERRAL/AMBULANCE: title（一覧表示用の見出し）＋ detail（様式ごとの構造化項目をJSON文字列で保持）
model KarteEntry {
  id           String         @id @default(cuid())
  caseId       String
  case         Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User           @relation(fields: [authorUserId], references: [id])
  entryType    KarteEntryType @default(SOAP)
  title        String? // REFERRAL/AMBULANCE等で一覧表示に使う見出し（例: 紹介先医療機関名）
  subjective   String         @default("")
  objective    String         @default("")
  assessment   String         @default("")
  plan         String         @default("")
  narrative    String         @default("") // NARRATIVE用の自由記述本文
  detail       String? // JSON文字列。REFERRAL/AMBULANCEの構造化項目
  createdAt    DateTime       @default(now())
}

// 問診・身体診察AIチャットのログ1件分。学生の発言とAI（模擬患者役）の応答を時系列で保持する。
model EncounterMessage {
  id           String        @id @default(cuid())
  caseId       String
  case         Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User          @relation(fields: [authorUserId], references: [id])
  role         EncounterRole
  content      String
  createdAt    DateTime      @default(now())
}

model DrugMaster {
  id             String             @id @default(cuid())
  hotCode        String             @unique
  name           String
  normalizedName String             @default("") // normalizeDrugName(name)。検索時にaliasesと同じ土俵で比較するためのキー
  category       String?
  defaultDose    String?
  unit           String?
  route          String?
  isInjectable   Boolean            @default(false) // true: 注射・点滴オーダーの対象 / false: 処方オーダーの対象
  orders         Order[]
  aliases        DrugAlias[]
  categoryLinks  DrugCategoryLink[]

  @@index([normalizedName])
}

// 薬効カテゴリの辞書(大分類+系統のペア)。表記ゆれをここ1箇所で管理するため、
// DrugMasterには直接文字列を持たせずDrugCategoryLink経由で多対多に紐付ける。
model DrugCategoryMaster {
  id            String   @id @default(cuid())
  majorCategory String // 大分類(例: 抗菌薬)
  subCategory   String? // 系統(例: セフェム系(第3世代))。大分類のみの場合はnull
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  links                    DrugCategoryLink[]
  pathogenSusceptibilities PathogenSusceptibility[]
  effectRules              DrugEffectRule[]

  @@unique([majorCategory, subCategory])
}

// 薬効カテゴリ(DrugCategoryMaster)が検査値・バイタルへ与える影響。1カテゴリが複数の対象
// (検査値・バイタルを問わず)へ影響してよい。疾患由来の値（重症度別パターン）とは独立した経路で、
// 疾患計算後の値へこのルールのshiftValueを単純加算する(薬剤どうしの相互作用は考慮しない)。
// 用量非依存の二値効果（投与中/非投与）として設計し、onsetDelayHoursの経過後に全量が即座に反映される
// （実臨床の緩やかな発現カーブは再現しない）。
model DrugEffectRule {
  id              String             @id @default(cuid())
  categoryId      String
  category        DrugCategoryMaster @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  targetType      String // "lab" | "vital"
  target          String // targetType=labなら検査コード(LabItemMaster.code。緩やかな参照)、targetType=vitalならVitalPointのキー(例: pulse)
  shiftValue      Float? // 基準値への加算量(数値化できる対象。例: PTなら+12秒、脈拍なら-15)
  effectText      String? // 定性所見への追記文(数値化できない所見用。現行20組み合わせでは未使用だが将来の拡張枠)
  onsetDelayHours Float              @default(0) // オーダーから効果発現までの時間(投与直後に反映するなら0)
  note            String? // 管理画面向けメモ(医学的根拠の記録用)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())

  @@unique([categoryId, targetType, target])
}

// 感染症エンジンが「症例の真の原因菌」として扱う原因菌マスター。
// 培養オーダーのグラム染色プレビュー開示にはgramStainを使う（同定確定前の所見として）。
model PathogenMaster {
  id        String   @id @default(cuid())
  name      String   @unique // 例: 肺炎球菌 (Streptococcus pneumoniae)
  gramStain String? // グラム染色区分。例: "グラム陽性球菌"。マイコプラズマ等、通常染色されない菌はnull
  note      String? // 補足（臨床像・好発部位など、教員向けの参考情報）
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  susceptibilities PathogenSusceptibility[]
  caseDiseaseLinks CaseDiseaseLink[]
}

// 原因菌 × 抗菌薬系統(DrugCategoryMaster)の感受性。感染症エンジンが「この抗菌薬は
// 原因菌をカバーしているか」を判定するのに使う。該当する行が無い(菌,系統)の組は
// 「カバーしない(R相当)」とみなす — 感受性が明確な組み合わせだけを陽性データとして
// 保持し、網羅的にR行を作らない方針（データ量を抑えるため）。
model PathogenSusceptibility {
  id             String             @id @default(cuid())
  pathogenId     String
  pathogen       PathogenMaster     @relation(fields: [pathogenId], references: [id], onDelete: Cascade)
  categoryId     String
  category       DrugCategoryMaster @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  susceptibility String // "S"(感受性あり) | "I"(中間・単剤では不十分等) | "R"(耐性)
  note           String? // 補足（例: "髄液移行に留意" 等、任意）

  @@unique([pathogenId, categoryId])
}

// 薬剤とカテゴリの多対多リンク。1薬剤が複数カテゴリ(例: 配合剤)に属してよい。
model DrugCategoryLink {
  id           String             @id @default(cuid())
  drugMasterId String
  drugMaster   DrugMaster         @relation(fields: [drugMasterId], references: [id], onDelete: Cascade)
  categoryId   String
  category     DrugCategoryMaster @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@unique([drugMasterId, categoryId])
  @@index([categoryId])
}

// 薬剤の別名(略称・俗称・表記ゆれ)。1つの別名が複数薬剤を指してよい(検索時は候補を複数返す)。
model DrugAlias {
  id             String     @id @default(cuid())
  drugMasterId   String
  drugMaster     DrugMaster @relation(fields: [drugMasterId], references: [id], onDelete: Cascade)
  aliasText      String // 表示用の別名そのまま(例: "生食", "タゾピペ")
  normalizedText String // normalizeDrugName(aliasText)。検索時の比較に使う
  aliasType      String? // 任意分類: "略称" / "俗称" / "旧称" / "表記ゆれ" など
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([drugMasterId, aliasText])
  @@index([normalizedText])
}

model LabItemMaster {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  category     String // 大分類（例: 検体・生理検査／画像検査）
  subcategory  String? // 中分類（例: 血算／生化学／単純写真／CT）。トグル一覧の入れ子グループ化に使用
  unit         String?
  sampleResult String? // 定性的な模擬結果文（画像所見・培養結果など、数値化しない項目用）
  sampleValues String? // JSON配列（LabValue[]）。数値項目の既定値。病態テンプレート対象外/未設定の症例でのフォールバックに使用
  sortOrder    Int     @default(0) // オーダー画面での表示順（昇順）。同値の場合は元の並びを維持
  // true: 培養系検査（血液培養等）。感染症エンジンによる多段階結果開示
  // (速報=グラム染色相当 → 確定=原因菌同定+感受性検査)の対象になる。
  isCulture    Boolean @default(false)
  orders       Order[]
}

// 用法テンプレート（例: 分3　朝昼夕）。処方・注射オーダーの用法欄で入力候補として使う。
// 今後、管理者マスター画面から追加・編集できるよう独立テーブルにしてある。
model UsageTemplate {
  id        String @id @default(cuid())
  label     String @unique
  sortOrder Int    @default(0)
}

model DiseaseTemplate {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String?
  isCommon        Boolean  @default(true)
  defaultParams   String // JSON文字列
  treatmentConfig String? // JSON文字列（TreatmentTrigger: drugCategories/procedureKeywords）。vitalsConfigと両方揃って初めてエンジン対応
  vitalsConfig    String? // JSON文字列（base/perSeverityバイタル係数）
  // AI治療評価（都度、治療オーダーの内容をGeminiに包括評価させ重症度カーブへ反映する仕組み）の採点ルーブリック。
  // 教員が「期待される治療方針・評価基準」を自由記述で登録する。未設定（null/空文字）のテンプレートではAI評価は発火しない。
  aiEvaluationGuideline String?
  // true: 感染症エンジンの対象テンプレート。症例作成画面で疾患ごとに「真の原因菌」を選択できるようになる。
  isInfectious    Boolean  @default(false)
  createdByUserId String?
  createdBy       User?    @relation("TemplateCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  diseaseLinks   CaseDiseaseLink[]
  labPatterns    TemplateLabPattern[]
  // このテンプレート自身の状態を監視し、条件を満たすと他の危機病態(テンプレート)をアタッチする発火設定。
  // 1テンプレートが複数件持てる(条件による分岐。例: 重症度基準で敗血症性ショックへ、SpO2基準で呼吸不全へ)。
  crisisTriggers TemplateCrisisScenario[] @relation("CrisisWatcher")
  // このテンプレートが「危機病態」としてアタッチされる場合の救命設定(単一)。通常疾患としてのみ使うテンプレートはnull。
  crisisRescue   CrisisRescueConfig?      @relation("CrisisRescueTarget")
  // 他のどのテンプレートの発火条件から狙われているか(参照用)
  triggeredBy    TemplateCrisisScenario[] @relation("CrisisTarget")
}

// 生理モデルの基礎値（バイタルのみ）。症例・疾患に関係なく1行だけ存在するシングルトン。
// 各病態モデルのperSeverity寄与はこの基礎値に単純加算される。検査値の基礎値はLabItemMaster.sampleValues/
// sampleResultを流用するため、こちらにはバイタルのみを持つ。
// PhysiologyBaselineBandがこの症例の年齢・性別に該当しない場合のフォールバック値としても使う（下記参照）。
// また各病態テンプレートのperSeverity値は「この基準値」を基準にスケーリングされて解釈されるため、
// これ自体が全年齢・全性別のスケール計算における参照点（基準の“標準成人”）を兼ねる。
model BasePhysiologyModel {
  id          String   @id @default("default")
  temperature Float    @default(36.5)
  systolicBp  Int      @default(120)
  diastolicBp Int      @default(70)
  pulse       Int      @default(75)
  spo2        Int      @default(98)
  respRate    Int      @default(16)
  updatedAt   DateTime @updatedAt
}

// 年齢・性別ごとの基礎生理値の上書き。症例のpatientAge/patientGenderに応じて、該当する帯域があれば
// BasePhysiologyModelの代わりにこちらの値を基準値として使う（該当なしならBasePhysiologyModelへフォールバック）。
// genderは"男性"|"女性"|"共通"（Case.patientGenderの表記に合わせる。"共通"は男女とも該当）。
// 年齢帯が重複する場合、性別が完全一致する行を優先し、次に"共通"の行を使う。
model PhysiologyBaselineBand {
  id          String   @id @default(cuid())
  label       String // 管理画面表示用ラベル（例:"乳児","成人男性" 等）
  minAge      Int // 対象年齢の下限（含む）
  maxAge      Int // 対象年齢の上限（含む）
  gender      String // "男性" | "女性" | "共通"
  temperature Float
  systolicBp  Int
  diastolicBp Int
  pulse       Int
  spo2        Int
  respRate    Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 病態テンプレートに紐づく検査所見パターン。検査項目コード(LabItemMaster.code)ごとに1行。
// LabItemMasterへの厳密な外部キーは張らない（マスター側のコード改番・削除に管理画面が追従できるよう緩やかな参照とする）。
model TemplateLabPattern {
  id          String          @id @default(cuid())
  templateId  String
  template    DiseaseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  labItemCode String
  kind        String // "text" | "values"
  mildText     String? // kind=textのときの軽症所見
  moderateText String? // kind=textのときの中等症所見
  severeText   String? // kind=textのときの重症所見
  sortOrder   Int             @default(0)

  values TemplateLabPatternValue[]

  @@unique([templateId, labItemCode])
}

// kind=valuesのTemplateLabPatternが重症度階層(tier)ごとに持つ数値所見。1階層に複数値を持てる
// （例: 動脈血液ガス分析がpH/pCO2/pO2等をまとめて返す）。
model TemplateLabPatternValue {
  id        String             @id @default(cuid())
  patternId String
  pattern   TemplateLabPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  tier      String // "mild" | "moderate" | "severe"
  label     String
  value     Float
  unit      String
  note      String?
  sortOrder Int                @default(0)
}

// 病態テンプレートに紐づく危機シナリオの発火条件(watcher視点)。1テンプレートが複数件持てる(条件分岐)。
// 発火すると、targetTemplateId のテンプレートを危機病態としてCaseDiseaseLinkへアタッチし、主病態に昇格させる。
model TemplateCrisisScenario {
  id               String          @id @default(cuid())
  templateId       String // このテンプレート自身の状態を監視する(watcher)
  template         DiseaseTemplate @relation("CrisisWatcher", fields: [templateId], references: [id], onDelete: Cascade)
  targetTemplateId String // 条件成立時にアタッチ・主病態昇格させる危機病態
  targetTemplate   DiseaseTemplate @relation("CrisisTarget", fields: [targetTemplateId], references: [id])
  // トリガー条件が連続して満たされてからCRITICALへ遷移するまでの猶予（分）。0＝瞬間発火。
  sustainMinutes   Int             @default(0)
  sortOrder        Int             @default(0) // 複数分岐がある場合の表示・評価順

  triggers CrisisTriggerRow[]
  progress CaseCrisisTriggerProgress[]
}

// 急変シナリオの発動条件（いずれか1つで発動=OR）
model CrisisTriggerRow {
  id         String                 @id @default(cuid())
  scenarioId String
  scenario   TemplateCrisisScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  type       String // "severity" | "lab" | "vital"
  code       String? // type=labのとき対象の検査項目コード
  label      String? // type=labのとき、複数値を返す検査での対象ラベル（省略時は先頭の値）
  field      String? // type=vitalのとき対象のバイタル項目名
  op         String // ">=" | "<="
  value      Float
  sortOrder  Int                    @default(0)
}

// 症例ごとに、危機シナリオの発火条件(TemplateCrisisScenario)が「連続して」満たされ始めた時刻を追跡する。
// 1テンプレートが複数の分岐を持てるため、症例単位ではなく(症例,シナリオ)単位で持続時間を追跡する。
// 条件を満たさなくなった時点で行を削除する。(今の時刻 - conditionSince) >= scenario.sustainMinutes で発火。
model CaseCrisisTriggerProgress {
  id             String                 @id @default(cuid())
  caseId         String
  case           Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  scenarioId     String
  scenario       TemplateCrisisScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  conditionSince DateTime

  @@unique([caseId, scenarioId])
}

// 危機病態(アタッチされる側のテンプレート)自身の救命設定。1テンプレートにつき最大1件。
// 複数の元疾患・複数の分岐が同じ危機病態を指すことがあり得るため、「治り方」は危機病態自身の性質として一定にする。
model CrisisRescueConfig {
  id                 String          @id @default(cuid())
  templateId         String          @unique
  template           DiseaseTemplate @relation("CrisisRescueTarget", fields: [templateId], references: [id], onDelete: Cascade)
  postRescueSeverity Int

  rescueActions CrisisRescueActionRow[]
}

// 危機病態から脱するための救命オーダー（いずれか1つで脱出=OR）
model CrisisRescueActionRow {
  id                String             @id @default(cuid())
  rescueConfigId    String
  rescueConfig      CrisisRescueConfig @relation(fields: [rescueConfigId], references: [id], onDelete: Cascade)
  label             String
  drugCategories    String // JSON文字列（string[]）
  procedureKeywords String // JSON文字列（string[]）
  sortOrder         Int                @default(0)
}

// AI治療評価1回分。オーダー提出をきっかけに作成され（PENDING）、バックグラウンドでGeminiの評価結果を書き戻す（COMPLETED/FAILED）。
// 成功時はseverityBaselineAtのリセット（急変救命成功時と同じ仕組み）を通じて重症度カーブへ反映する。
// ordersSnapshotHashで同一オーダー集合への重複評価を防ぐ。監査用に評価対象オーダーIDと根拠テキストを保持する。
model TreatmentEvaluation {
  id                   String                    @id @default(cuid())
  caseId               String
  case                 Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status               TreatmentEvaluationStatus @default(PENDING)
  ordersSnapshotHash   String
  orderIdsSnapshot     String // JSON配列（string[]）。評価対象としたオーダーID（監査・教員閲覧用）
  appropriatenessScore Int? // 0-100。AIによる治療適切性スコア
  contraindicated      Boolean @default(false) // AIが禁忌等の重大な問題を検知した場合true（即座に重症度がジャンプする）
  severityRatePerHour  Float? // このAI評価から主病態のCaseDiseaseLink.aiSeverityRatePerHourへ適用した時間あたりの重症度変化量
  resetSeverity        Int? // 成功時にseverityBaselineAtリセットとともに適用した重症度（0-100、禁忌ジャンプ後の値）
  rationale            String? // AIの評価根拠（教員監査用に表示）
  rawResponse          String? // 生レスポンス（デバッグ用）
  errorMessage         String? // FAILED時のエラー内容
  requestedAt          DateTime                  @default(now())
  completedAt          DateTime?

  @@index([caseId, ordersSnapshotHash])
}

model Order {
  id              String         @id @default(cuid())
  caseId          String
  case            Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  orderedByUserId String
  orderedBy       User           @relation(fields: [orderedByUserId], references: [id])
  orderType       OrderType
  label           String // 表示名（マスター名 or 一般指示の内容）
  detail          String? // JSON文字列（用量・経路・カテゴリ・補足テキスト等）
  labItemId       String?
  labItem         LabItemMaster? @relation(fields: [labItemId], references: [id])
  drugId          String?
  drug            DrugMaster?    @relation(fields: [drugId], references: [id])
  status          OrderStatus    @default(ORDERED)
  orderedAt       DateTime       @default(now())
  // 培養系検査(LabItemMaster.isCulture)のみ使用。速報(グラム染色相当)を反映する時刻。
  // 通常検査ではnull（resultReadyAtのみで単一段階の結果反映）。
  preliminaryResultReadyAt DateTime?
  resultReadyAt   DateTime?
  resultText      String?
  resultValues    String? // JSON配列（LabValue[]）。数値項目の構造化結果。H/L判定・色分け表示に使用
  rpGroupId       String? // Rp単位でまとめるための識別子。同じRpに含まれる複数薬剤オーダーが共有する
  rpLabel         String? // 表示用のRp番号（例: "Rp.1"）
  // 処方・注射オーダーの中止時刻（症例時刻）。null=継続中。中止後は薬剤影響エンジンの対象から外れる
  // （statusをDISCONTINUEDに更新すると同時にセットする）。
  discontinuedAt  DateTime?
}

model Vital {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  recordedAt  DateTime @default(now())
  temperature Float?
  systolicBp  Int?
  diastolicBp Int?
  pulse       Int?
  spo2        Int?
  respRate    Int?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String?
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())
}
