          "severe": [{ "label": "動脈血pH", "value": 7.15, "unit": "" }, { "label": "pCO2", "value": 85, "unit": "mmHg" }]
        }
      }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_resp_failure", "sustainMinutes": 20, "triggers": [{ "type": "lab", "code": "3H080", "label": "pCO2", "op": ">=", "value": 80 }] }]
  },
  {
    "key": "resp_pneumothorax",
    "name": "自然気胸",
    "description": "肺嚢胞の破裂等による胸腔内への空気漏出。若年やせ型男性に好発し、突然の胸痛・呼吸困難を呈する。",
    "category": "呼吸器",
