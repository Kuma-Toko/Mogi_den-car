[
  {
    "key": "resp_cap",
    "name": "市中肺炎",
    "description": "市中で発症する細菌性肺炎。発熱・咳嗽・膿性痰と炎症反応上昇、酸素化低下を特徴とする。",
    "category": "呼吸器",
    "sortOrder": 1,
    "isInfectious": true,
    "defaultParams": { "initialTempSlider": 78, "improvementSpeedSlider": 45, "initialSpo2Slider": 55, "severitySlider": 55 },
    "treatment": { "drugCategories": ["抗菌薬"] },
    "vitalsPerSeverity": { "temperature": 3.5, "systolicBp": -15, "diastolicBp": -8, "pulse": 35, "spo2": -30, "respRate": 20 },
    "aiEvaluationGuideline": "第一選択は広域抗菌薬（セフェム系またはカルバペネム系）の早期静注投与。発症から投与開始が早いほど加点。血圧低下・頻脈時の輸液併用も加点。解熱剤のみで抗菌薬未投与は原因治療になっておらず大幅減点。感染巣と明らかに合わない抗菌薬選択（グラム陽性菌用薬のみ等）も減点。",
    "labPatterns": [
      {
        "labItemCode": "5C070",
        "kind": "values",
        "tiers": {
          "mild": [{ "label": "CRP", "value": 3, "unit": "mg/dL" }],
          "moderate": [{ "label": "CRP", "value": 12, "unit": "mg/dL" }],
          "severe": [{ "label": "CRP", "value": 28, "unit": "mg/dL" }]
        }
      },
      {
        "labItemCode": "2A010",
        "kind": "values",
        "tiers": {
          "mild": [{ "label": "WBC", "value": 11000, "unit": "/μL" }],
          "moderate": [{ "label": "WBC", "value": 16000, "unit": "/μL" }],
          "severe": [{ "label": "WBC", "value": 22000, "unit": "/μL" }]
        }
      },
      {
        "labItemCode": "5C215",
        "kind": "values",
        "tiers": {
          "mild": [{ "label": "PCT", "value": 0.3, "unit": "ng/mL" }],
          "moderate": [{ "label": "PCT", "value": 2, "unit": "ng/mL" }],
          "severe": [{ "label": "PCT", "value": 15, "unit": "ng/mL" }]
        }
      },
      { "labItemCode": "IMG-001", "kind": "text", "tiers": { "mild": "右下肺野に浸潤影を疑う淡い陰影を認める。", "moderate": "右下肺野に明瞭な浸潤影を認める。", "severe": "両側性に浸潤影が拡大し、胸水貯留を伴う。" } }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_septic_shock", "sustainMinutes": 30, "triggers": [{ "type": "vital", "field": "spo2", "op": "<=", "value": 80 }, { "type": "severity", "op": ">=", "value": 90 }] }]
  },
  {
    "key": "resp_aspiration_pneumonia",
    "name": "誤嚥性肺炎",
    "description": "咽頭・口腔内容物の誤嚥に伴う肺炎。嚥下機能低下を背景に高齢者で多く、反復傾向がある。",
    "category": "呼吸器",
    "sortOrder": 2,
    "isInfectious": true,
    "defaultParams": { "initialTempSlider": 70, "improvementSpeedSlider": 35, "initialSpo2Slider": 60, "severitySlider": 55 },
    "treatment": { "drugCategories": ["抗菌薬"] },
    "vitalsPerSeverity": { "temperature": 3.0, "systolicBp": -15, "diastolicBp": -8, "pulse": 30, "spo2": -35, "respRate": 18 },
    "aiEvaluationGuideline": "嫌気性菌もカバーする広域抗菌薬の早期投与が標準治療。誤嚥予防（体位管理・嚥下評価）の指示があれば加点。抗菌薬未投与は大幅減点。",
    "labPatterns": [
      {
        "labItemCode": "5C070",
        "kind": "values",
        "tiers": {
          "mild": [{ "label": "CRP", "value": 4, "unit": "mg/dL" }],
          "moderate": [{ "label": "CRP", "value": 14, "unit": "mg/dL" }],
          "severe": [{ "label": "CRP", "value": 25, "unit": "mg/dL" }]
        }
      },
      { "labItemCode": "IMG-001", "kind": "text", "tiers": { "mild": "右下葉背側にごく淡い浸潤影を認める。", "moderate": "右下葉背側優位に浸潤影を認める（誤嚥性肺炎パターン）。", "severe": "両側下葉に浸潤影が拡大し、膿瘍形成を疑う空洞影を伴う。" } }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_septic_shock", "sustainMinutes": 20, "triggers": [{ "type": "vital", "field": "spo2", "op": "<=", "value": 78 }, { "type": "severity", "op": ">=", "value": 85 }] }]
  },
  {
    "key": "resp_tb",
    "name": "肺結核",
    "description": "結核菌による慢性肺感染症。微熱・盗汗・体重減少と血痰、慢性咳嗽を特徴とする。",
    "category": "呼吸器",
    "sortOrder": 3,
    "isInfectious": true,
    "defaultParams": { "initialTempSlider": 45, "improvementSpeedSlider": 12, "initialSpo2Slider": 65, "severitySlider": 40 },
    "treatment": { "drugCategories": ["抗結核薬"] },
    "vitalsPerSeverity": { "temperature": 1.5, "systolicBp": -5, "diastolicBp": -3, "pulse": 10, "spo2": -15, "respRate": 6 },
    "aiEvaluationGuideline": "イソニアジド・リファンピシン・エタンブトール・ピラジナミドの多剤併用療法（少なくとも2剤以上の併用）が標準治療。単剤投与は耐性化リスクがあり減点。空気感染対策（陰圧個室隔離等）の記載があれば加点。",
    "labPatterns": [
      { "labItemCode": "MB-003", "kind": "text", "tiers": { "mild": "抗酸菌塗抹陰性、培養で少数のコロニー発育。", "moderate": "抗酸菌塗抹陽性（1+程度）。", "severe": "抗酸菌塗抹強陽性（3+以上）、排菌量が多い。" } },
      { "labItemCode": "IMG-001", "kind": "text", "tiers": { "mild": "両側上肺野にごく淡い粒状影を認める。", "moderate": "右上肺野に空洞形成を伴う浸潤影を認める。", "severe": "両側上肺野に多発空洞と気管支散布性病変を認める。" } }
    ]
  },
  {
    "key": "resp_asthma",
    "name": "気管支喘息発作",
    "description": "気道の可逆性狭窄による喘鳴・呼吸困難発作。夜間・早朝の増悪が典型的。",
    "category": "呼吸器",
