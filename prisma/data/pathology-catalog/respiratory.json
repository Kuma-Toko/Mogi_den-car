          "severe": [{ "label": "動脈血pH", "value": 7.28, "unit": "" }, { "label": "pCO2", "value": 55, "unit": "mmHg" }]
        }
      }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_resp_failure", "sustainMinutes": 15, "triggers": [{ "type": "vital", "field": "spo2", "op": "<=", "value": 75 }] }]
  },
  {
    "key": "resp_copd_exacerbation",
    "name": "COPD増悪",
    "description": "慢性閉塞性肺疾患の急性増悪。感染契機が多く、CO2貯留（CO2ナルコーシス）に注意を要する。",
    "category": "呼吸器",
