        }
      },
      { "labItemCode": "IMG-CT-009", "kind": "text", "tiers": { "mild": "亜区域枝レベルに小さな陰影欠損を認める。", "moderate": "葉動脈レベルに陰影欠損を認める。", "severe": "主肺動脈〜両側肺動脈にわたる広範な陰影欠損（鞍状血栓）を認める。" } }
