    "vitalsPerSeverity": { "temperature": 0, "systolicBp": -10, "diastolicBp": -5, "pulse": 20, "spo2": -20, "respRate": 14 },
    "aiEvaluationGuideline": "軽度なら経過観察も許容されるが、中等度以上は胸腔ドレナージが必要。緊張性気胸への進展兆候（血圧低下・頻脈増悪）を見逃さず速やかに処置する記載を評価する。",
    "labPatterns": [
      { "labItemCode": "IMG-XP-006", "kind": "text", "tiers": { "mild": "肺尖部に軽度の気胸を認める（虚脱率20%未満）。", "moderate": "中等度の肺虚脱を認める（虚脱率50%程度）。", "severe": "高度の肺虚脱を認め、緊張性気胸への進展が懸念される。" } }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_tension_pneumothorax", "sustainMinutes": 10, "triggers": [{ "type": "vital", "field": "spo2", "op": "<=", "value": 80 }] }]
  },
  {
    "key": "resp_pe",
    "name": "肺血栓塞栓症（PE）",
    "description": "下肢深部静脈血栓等の塞栓子が肺動脈を閉塞する疾患。突然の呼吸困難・胸痛・低酸素血症を呈する。",
