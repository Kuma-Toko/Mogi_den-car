    "crisisTriggers": [{ "targetKey": "crisis_cardiogenic_shock", "sustainMinutes": 30, "triggers": [{ "type": "vital", "field": "systolicBp", "op": "<=", "value": 80 }] }]
  },
  {
    "key": "cv_afib_rvr",
    "name": "心房細動（頻脈性）",
    "description": "心房細動による頻脈性不整脈。心拍数コントロールが不十分だと血行動態が破綻しうる。",
    "category": "循環器",
    "sortOrder": 4,
    "defaultParams": { "initialTempSlider": 35, "improvementSpeedSlider": 55, "initialSpo2Slider": 70, "severitySlider": 45 },
    "treatment": { "drugCategories": ["β遮断薬", "抗不整脈薬"] },
    "vitalsPerSeverity": { "temperature": 0, "systolicBp": -12, "diastolicBp": -6, "pulse": 130, "spo2": -3, "respRate": 5 },
    "aiEvaluationGuideline": "β遮断薬等によるレートコントロールが基本。血栓塞栓症予防の抗凝固薬（CHADS2スコアに応じて）の検討も評価対象。",
    "labPatterns": [
      { "labItemCode": "PHYS-ECG-001", "kind": "text", "tiers": { "mild": "心房細動、心拍数110/分程度。", "moderate": "心房細動、心拍数140/分程度の頻脈。", "severe": "心房細動、心拍数170/分以上の高度頻脈。" } }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_cardiogenic_shock", "sustainMinutes": 30, "triggers": [{ "type": "vital", "field": "pulse", "op": ">=", "value": 170 }] }]
  },
  {
    "key": "cv_complete_avb",
    "name": "完全房室ブロック",
    "description": "心房から心室への電気伝導が完全に途絶した状態。補充調律が不十分だと心停止に至る。",
    "category": "循環器",
    "sortOrder": 5,
    "defaultParams": { "initialTempSlider": 30, "improvementSpeedSlider": 45, "initialSpo2Slider": 75, "severitySlider": 55 },
    "treatment": { "procedureKeywords": ["経皮的ペーシング・ペースメーカー植込み"] },
    "vitalsPerSeverity": { "temperature": -0.1, "systolicBp": -30, "diastolicBp": -14, "pulse": -50, "spo2": -5, "respRate": 4 },
    "aiEvaluationGuideline": "一時ペーシング・恒久ペースメーカー植込みが根本治療。経過観察のみは徐脈の進行・心停止のリスクを見逃しており大幅減点。",
    "labPatterns": [
      { "labItemCode": "PHYS-ECG-001", "kind": "text", "tiers": { "mild": "PR間隔の延長を伴う房室ブロックを認める。", "moderate": "心房と心室の調律が解離した完全房室ブロックを認める。", "severe": "高度徐脈を伴う完全房室ブロックで補充調律が不安定。" } }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_cardiac_arrest", "sustainMinutes": 20, "triggers": [{ "type": "vital", "field": "pulse", "op": "<=", "value": 30 }] }]
  },
  {
    "key": "cv_aortic_dissection",
    "name": "急性大動脈解離",
    "description": "大動脈壁の中膜が裂けて生じる致死的疾患。突然発症の引き裂かれるような胸背部痛を特徴とする。",
