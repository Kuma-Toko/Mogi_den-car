          "severe": [{ "label": "BNP", "value": 1500, "unit": "pg/mL" }]
        }
      },
      { "labItemCode": "IMG-001", "kind": "text", "tiers": { "mild": "軽度の肺血管陰影増強を認める。", "moderate": "両側肺うっ血像とKerley B線を認める。", "severe": "著明な肺うっ血・胸水貯留を認める。" } }
