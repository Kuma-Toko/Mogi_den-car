    "defaultParams": { "initialTempSlider": 35, "improvementSpeedSlider": 35, "initialSpo2Slider": 60, "severitySlider": 60 },
    "treatment": { "drugCategories": ["β遮断薬"] },
    "vitalsPerSeverity": { "temperature": 0, "systolicBp": 25, "diastolicBp": 15, "pulse": 18, "spo2": -6, "respRate": 6 },
    "aiEvaluationGuideline": "β遮断薬を中心とした厳格な降圧・心拍数コントロールが初期治療の要。Stanford A型は緊急手術の適応となるため外科コンサルトの記載も評価する。降圧薬未使用は解離進展のリスクを放置しており大幅減点。",
    "labPatterns": [
      { "labItemCode": "IMG-CT-008", "kind": "text", "tiers": { "mild": "上行大動脈にごく限局した解離腔を疑う所見。", "moderate": "上行大動脈から下行大動脈に及ぶ解離腔（フラップ）を認める。", "severe": "広範囲に及ぶ解離腔と心嚢液貯留を認める。" } }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_hemorrhagic_shock", "sustainMinutes": 20, "triggers": [{ "type": "severity", "op": ">=", "value": 90 }] }]
  },
  {
    "key": "cv_hypertensive_emergency",
