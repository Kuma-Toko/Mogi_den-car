[
  {
    "key": "cv_stemi",
    "name": "急性心筋梗塞（STEMI）",
    "description": "冠動脈の急性完全閉塞による貫壁性心筋壊死。心筋逸脱酵素の上昇と心電図のST上昇を特徴とする。",
    "category": "循環器",
    "sortOrder": 1,
    "defaultParams": { "initialTempSlider": 40, "improvementSpeedSlider": 50, "initialSpo2Slider": 55, "severitySlider": 60 },
    "treatment": { "drugCategories": ["抗血小板薬"], "procedureKeywords": ["経皮的冠動脈インターベンション（PCI）"] },
    "vitalsPerSeverity": { "temperature": 0.3, "systolicBp": -45, "diastolicBp": -20, "pulse": 30, "spo2": -10, "respRate": 8 },
    "aiEvaluationGuideline": "発症後できるだけ早期の経皮的冠動脈インターベンション（PCI）による再灌流が予後を決定する。抗血小板薬（アスピリン等）の早期投与も加点。再灌流治療の指示がなく抗血小板薬のみの場合は不十分な対応として減点。",
    "labPatterns": [
      {
        "labItemCode": "5C093",
        "kind": "values",
        "tiers": {
          "mild": [{ "label": "トロポニンT", "value": 0.1, "unit": "ng/mL" }],
          "moderate": [{ "label": "トロポニンT", "value": 1.5, "unit": "ng/mL" }],
          "severe": [{ "label": "トロポニンT", "value": 8, "unit": "ng/mL" }]
        }
      },
      {
        "labItemCode": "3B015",
        "kind": "values",
        "tiers": {
          "mild": [{ "label": "CK-MB", "value": 40, "unit": "U/L" }],
          "moderate": [{ "label": "CK-MB", "value": 120, "unit": "U/L" }],
          "severe": [{ "label": "CK-MB", "value": 300, "unit": "U/L" }]
        }
      },
      { "labItemCode": "PHYS-ECG-001", "kind": "text", "tiers": { "mild": "軽度のST上昇を認める。", "moderate": "誘導群にわたる有意なST上昇を認める。", "severe": "広範囲誘導での著明なST上昇とQ波形成を認める。" } }
    ],
    "crisisTriggers": [
      { "targetKey": "crisis_cardiogenic_shock", "sustainMinutes": 30, "triggers": [{ "type": "vital", "field": "systolicBp", "op": "<=", "value": 80 }] },
      { "targetKey": "crisis_cardiac_arrest", "sustainMinutes": 15, "triggers": [{ "type": "severity", "op": ">=", "value": 95 }] }
    ]
  },
  {
    "key": "cv_nstemi",
    "name": "不安定狭心症・NSTEMI",
    "description": "冠動脈の不完全閉塞または高度狭窄による心筋虚血。STEMIより緩徐だが放置すれば進行しうる。",
    "category": "循環器",
    "sortOrder": 2,
    "defaultParams": { "initialTempSlider": 35, "improvementSpeedSlider": 50, "initialSpo2Slider": 65, "severitySlider": 45 },
    "treatment": { "drugCategories": ["抗血小板薬", "抗凝固薬"] },
    "vitalsPerSeverity": { "temperature": 0.2, "systolicBp": -18, "diastolicBp": -10, "pulse": 16, "spo2": -6, "respRate": 5 },
    "aiEvaluationGuideline": "抗血小板薬・抗凝固薬による早期の薬物療法と、リスク評価に基づく待機的〜早期のカテーテル検査の検討が標準治療。無投薬での経過観察は減点。",
    "labPatterns": [
      {
        "labItemCode": "5C093",
        "kind": "values",
        "tiers": {
          "mild": [{ "label": "トロポニンT", "value": 0.03, "unit": "ng/mL" }],
          "moderate": [{ "label": "トロポニンT", "value": 0.2, "unit": "ng/mL" }],
          "severe": [{ "label": "トロポニンT", "value": 0.6, "unit": "ng/mL" }]
        }
      },
      { "labItemCode": "PHYS-ECG-001", "kind": "text", "tiers": { "mild": "軽度のST低下を認める。", "moderate": "有意なST低下と陰性T波を認める。", "severe": "広範な誘導でのST低下が持続する。" } }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_cardiogenic_shock", "sustainMinutes": 45, "triggers": [{ "type": "severity", "op": ">=", "value": 90 }] }]
  },
  {
    "key": "cv_acute_hf",
    "name": "急性心不全（うっ血性）",
