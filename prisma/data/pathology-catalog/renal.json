[
  {
    "key": "renal_prerenal_aki",
    "name": "腎前性急性腎障害（脱水）",
    "description": "高度脱水による腎血流低下に伴う急性腎障害。輸液による腎前性の是正で速やかに改善しうる。",
    "category": "腎・電解質",
    "sortOrder": 1,
    "defaultParams": { "initialTempSlider": 40, "improvementSpeedSlider": 100, "initialSpo2Slider": 75, "severitySlider": 40 },
    "treatment": { "drugCategories": ["輸液"] },
    "vitalsPerSeverity": { "temperature": 0, "systolicBp": -45, "diastolicBp": -18, "pulse": 25, "spo2": -3, "respRate": 3 },
    "aiEvaluationGuideline": "細胞外液の輸液による腎前性因子の是正が第一選択。利尿薬の投与は腎血流をさらに悪化させるため禁忌に近い判断となりうる。",
    "labPatterns": [
      {
        "labItemCode": "3C015",
        "kind": "values",
        "tiers": {
          "mild": [{ "label": "Cr", "value": 1.5, "unit": "mg/dL" }],
          "moderate": [{ "label": "Cr", "value": 2.8, "unit": "mg/dL" }],
          "severe": [{ "label": "Cr", "value": 5, "unit": "mg/dL" }]
        }
      },
      {
        "labItemCode": "3C025",
        "kind": "values",
        "tiers": {
          "mild": [{ "label": "BUN", "value": 30, "unit": "mg/dL" }],
          "moderate": [{ "label": "BUN", "value": 55, "unit": "mg/dL" }],
          "severe": [{ "label": "BUN", "value": 90, "unit": "mg/dL" }]
        }
      }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_hypovolemic_shock", "sustainMinutes": 30, "triggers": [{ "type": "vital", "field": "systolicBp", "op": "<=", "value": 80 }] }]
  },
  {
    "key": "renal_hyperkalemia",
    "name": "高カリウム血症",
    "description": "腎機能低下・薬剤等による血清カリウム上昇。心電図異常から致死性不整脈に進展しうる。",
    "category": "腎・電解質",
    "sortOrder": 2,
    "defaultParams": { "initialTempSlider": 30, "improvementSpeedSlider": 60, "initialSpo2Slider": 90, "severitySlider": 45 },
