    "aiEvaluationGuideline": "インスリン・グルコース療法による細胞内シフトが即時対応。原因薬剤（ACE阻害薬・K保持性利尿薬等）の中止と、腎機能低下例では透析の検討も評価する。",
    "labPatterns": [
      {
        "labItemCode": "3H015",
        "kind": "values",
        "tiers": {
          "mild": [{ "label": "K", "value": 5.8, "unit": "mEq/L" }],
          "moderate": [{ "label": "K", "value": 6.8, "unit": "mEq/L" }],
          "severe": [{ "label": "K", "value": 8, "unit": "mEq/L" }]
        }
      },
      { "labItemCode": "PHYS-ECG-001", "kind": "text", "tiers": { "mild": "軽度のT波増高を認める。", "moderate": "テント状T波を認める。", "severe": "QRS幅の延長を伴うテント状T波を認める。" } }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_lethal_hyperkalemia", "sustainMinutes": 15, "triggers": [{ "type": "lab", "code": "3H015", "op": ">=", "value": 7.5 }] }]
  },
