      { "labItemCode": "PHYS-ECG-001", "kind": "text", "tiers": { "mild": "QT短縮を軽度認める。", "moderate": "明らかなQT短縮を認める。", "severe": "著明なQT短縮とともに不整脈の出現を認める。" } }
    ],
    "crisisTriggers": [{ "targetKey": "crisis_cardiac_arrest", "sustainMinutes": 30, "triggers": [{ "type": "lab", "code": "3H030", "op": ">=", "value": 15 }] }]
