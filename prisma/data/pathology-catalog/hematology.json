      {
        "labItemCode": "3C020",
        "kind": "values",
        "tiers": {
          "mild": [{ "label": "UA", "value": 9, "unit": "mg/dL" }],
          "moderate": [{ "label": "UA", "value": 14, "unit": "mg/dL" }],
          "severe": [{ "label": "UA", "value": 20, "unit": "mg/dL" }]
        }
      }
